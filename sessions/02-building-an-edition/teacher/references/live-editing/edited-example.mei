    <body>
      <mdiv n="1">
        <score>
          <scoreDef meter.count="4" meter.unit="4" keysig="1f" meter.sym="common">
            <staffGrp symbol="brace">
              <staffDef n="1" xml:id="s1" clef.shape="G" clef.line="2" lines="5"/>
              <staffDef n="2" xml:id="s2" clef.shape="F" clef.line="4" lines="5"/>
            </staffGrp>
          </scoreDef>
          <section>
            <pb xml:id="pb-schumann-op68-no10-source-page-p0001" n="8" facs="#surface-schumann-op68-no10-source-page-p0001"/>
            <measure n="1" xml:id="d1e9" type="upbeat" metcon="false" facs="#zone-schumann-op68-no10-source-page-p0001-001">
              <staff n="1">
                <layer n="1">
                  <rest xml:id="d1e30" dur="8"/>
                </layer>
              </staff>
              <staff n="2">
                <layer n="1">
                  <note xml:id="d1e60" pname="c" oct="3" dur="8" stem.dir="up"/>
                </layer>
              </staff>
            <dynam staff="1" place="below" tstamp="1" xml:id="seminar-dynam-opening">f</dynam><tempo staff="1" place="above" tstamp="1" xml:id="seminar-tempo-opening">Frisch und munter.</tempo><slur staff="2" curvedir="above" startid="#d1e60" endid="#d1e338" xml:id="seminar-slur-pickup"/><annot type="editorial" label="Opening slur division" plist="#d1e60 #d1e338 #d1e561 #d1e634" xml:id="seminar-annot-opening-slurs">
                <p>IMSLP 51556, printed p. 8, first system: the pickup-to-F3 slur ends in the first full bar; a separate B-flat3-to-A3 slur occupies the second full bar. The base MEI instead joins the pickup to C4 in the second full bar. This exercise follows the selected print. Other missing expressive marks remain to be edited.</p>
              </annot></measure>
            <measure n="2" xml:id="d1e74" facs="#zone-schumann-op68-no10-source-page-p0001-002">
              <staff n="1">
                <layer n="1">
                  <rest xml:id="d1e76" dur="8"/>
                  <chord xml:id="d21e1" dur="8" stem.dir="up">
                    <note xml:id="d1e86" pname="c" oct="4"/>
                    <note xml:id="d1e100" pname="f" oct="4"/>
                    <note xml:id="d1e115" pname="a" oct="4"/>
                  </chord>
                  <chord xml:id="d25e1" dur="8" stem.dir="up">
                    <note xml:id="d1e130" pname="c" oct="4"/>
                    <note xml:id="d1e144" pname="f" oct="4"/>
                    <note xml:id="d1e159" pname="a" oct="4"/>
                  </chord>
                  <rest xml:id="d1e174" dur="8"/>
                  <rest xml:id="d1e184" dur="8"/>
                  <chord xml:id="d29e1" dur="8" stem.dir="up">
                    <note xml:id="d1e194" pname="f" oct="4"/>
                    <note xml:id="d1e208" pname="a" oct="4"/>
                    <note xml:id="d1e224" pname="c" oct="5"/>
                  </chord>
                  <chord xml:id="d33e1" dur="8" stem.dir="up">
                    <note xml:id="d1e239" pname="f" oct="4"/>
                    <note xml:id="d1e253" pname="a" oct="4"/>
                    <note xml:id="d1e268" pname="c" oct="5"/>
                  </chord>
                  <rest xml:id="d1e283" dur="8"/>
                </layer>
              </staff>
              <staff n="2">
                <layer n="1">
                  <note xml:id="d1e294" pname="f" oct="3" dur="4" dots="1" stem.dir="down"/>
                  <note xml:id="d1e309" pname="a" oct="3" dur="8" stem.dir="down"/>
                  <note xml:id="d1e323" pname="c" oct="4" dur="4" dots="1" stem.dir="down"/>
                  <note xml:id="d1e338" pname="f" oct="3" dur="8" stem.dir="down"/>
                </layer>
              </staff>
            </measure>
            <measure n="3" xml:id="d1e352" facs="#zone-schumann-op68-no10-source-page-p0001-003">
              <staff n="1">
                <layer n="1">
                  <rest xml:id="d1e354" dur="8"/>
                  <chord xml:id="d50e1" dur="8" stem.dir="up">
                    <note xml:id="d1e364" pname="f" oct="4"/>
                    <note xml:id="d1e378" pname="b" oct="4" accid.ges="f"/>
                    <note xml:id="d1e395" pname="d" oct="5"/>
                  </chord>
                  <chord xml:id="d54e1" dur="8" stem.dir="up">
                    <note xml:id="d1e410" pname="b" oct="4" accid.ges="f"/>
                    <note xml:id="d1e426" pname="d" oct="5"/>
                  </chord>
                  <rest xml:id="d1e441" dur="8"/>
                  <rest xml:id="d1e451" dur="8"/>
                  <chord xml:id="d58e1" dur="8" stem.dir="up">
                    <note xml:id="d1e461" pname="f" oct="4"/>
                    <note xml:id="d1e475" pname="a" oct="4"/>
                    <note xml:id="d1e490" pname="c" oct="5"/>
                  </chord>
                  <chord xml:id="d62e1" dur="8" stem.dir="up">
                    <note xml:id="d1e506" pname="f" oct="4"/>
                    <note xml:id="d1e520" pname="a" oct="4"/>
                    <note xml:id="d1e535" pname="c" oct="5"/>
                  </chord>
                  <rest xml:id="d1e550" dur="8"/>
                </layer>
              </staff>
              <staff n="2">
                <layer n="1">
                  <beam>
